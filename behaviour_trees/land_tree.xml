<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Fallback name="MainFallback">
      <Sequence name="LandingOnAruco">
        <DetectAruco aruco_pose="{aruco_pose}" />
        <AlignToAruco aruco_pose="{aruco_pose}" />
        <LandOnMarker aruco_pose="{aruco_pose}"/>
      </Sequence>
      <Sequence name="GoToGPS">
        <GetDJIPose dji_pose="{dji_pose}"/>
        <GetGPSGoal gps_goal="{gps_goal}"/>
        <GoToGPS dji_pose="{dji_pose}" gps_goal="{gps_goal}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>
</root>
